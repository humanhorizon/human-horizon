---
// Closing call to action on ink, with the white horizon supergraphic.
import Supergraphic from './Supergraphic.astro';
import { site } from '../data/site';

interface Props { title: string; sub: string; cta?: { label: string; href: string }; secondary?: { label: string; href: string } }
const { title, sub, cta = site.cta, secondary } = Astro.props;
---
<section class="close bg-ink">
  <div class="wrap"><h2 class="d close-h clear">{title}</h2></div>
  <Supergraphic tone="white" />
  <div class="wrap close-low">
    <div class="btn-row">
      <a class="btn btn-sun" href={cta.href}>{cta.label}</a>
      {secondary && <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
    <p class="muted clear">{sub}</p>
  </div>
</section>

<style>
  /* Text beside the ring stops short of its footprint: about 0.58 of the ring size in from the right edge. */
  .close { --S: clamp(180px, 46vw, 760px); --mw: 720px; position: relative; overflow: hidden; padding: clamp(80px, 10vw, 150px) 0 clamp(80px, 10vw, 140px); }
  .clear { max-width: min(var(--mw), calc(100vw - var(--S) * 0.58 - var(--gutter) - 32px)); }
  .close-low .clear { --mw: 520px; }
  .close-h { font-size: clamp(35px, 3.8vw, 50px); margin-bottom: 36px; position: relative; z-index: 1; }
  .close-low { padding-top: 40px; display: flex; gap: var(--s4); align-items: center; flex-wrap: wrap; position: relative; z-index: 1; }
  .close-low a:not(.btn) { color: #fff; }
  @media (max-width: 760px) {
    .clear, .close-low .clear { max-width: 100%; }
    .close-h { margin-bottom: calc(var(--S) * 0.38 + 16px); }
    .close-low { padding-top: calc(var(--S) * 0.38 + 16px); }
  }
</style>
