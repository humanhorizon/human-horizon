---
// Site-wide announcement for the founding pilots. Stays pinned to the top until the visitor closes it.
import { site } from '../data/site';
---
<div class="pilot-bar" data-pilot-bar>
  <p>
    <span class="long">{site.pilot.bar}</span>
    <span class="short">{site.pilot.short}</span>
    <a href={site.cta.href}>{site.pilot.link}</a>
  </p>
  <button type="button" aria-label="Close announcement" data-pilot-close>×</button>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-pilot-bar]');
  try { if (bar && sessionStorage.getItem('hh-pilot-closed')) bar.hidden = true; } catch {}
  document.querySelector('[data-pilot-close]')?.addEventListener('click', () => {
    if (bar) bar.hidden = true;
    try { sessionStorage.setItem('hh-pilot-closed', '1'); } catch {}
  });
</script>

<style>
  .pilot-bar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: center; gap: var(--s2); padding: 10px 56px; background: var(--sunrise); color: var(--ink); font-size: 15px; line-height: 1.4; text-align: center; }
  .pilot-bar[hidden] { display: none; }
  .pilot-bar p { margin: 0; }
  .pilot-bar a { margin-left: 12px; font-weight: 600; color: var(--ink); text-underline-offset: 3px; white-space: nowrap; }
  .pilot-bar button { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; border: 0; border-radius: 50%; background: none; color: var(--ink); font-size: 22px; line-height: 1; cursor: pointer; }
  .pilot-bar button:hover { background: rgba(24, 33, 59, .12); }
  .short { display: none; }
  @media (max-width: 760px) {
    .pilot-bar { justify-content: flex-start; text-align: left; padding: 10px 52px 10px var(--gutter); }
    .long { display: none; }
    .short { display: inline; }
  }
</style>
