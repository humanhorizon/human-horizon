---
// One workflow told as an outcome, then before and after. Used by the homepage picker and the industry and team pages.
import type { Segment, Workflow } from '../data/site';

interface Props { segment?: Segment; workflow?: Workflow; hub?: string; id?: string; group?: string; hidden?: boolean; heading?: boolean }
const { segment: s, workflow, hub, id, group, hidden = false, heading = false } = Astro.props;
const w = workflow ?? s!.workflow;
const Tag = heading ? 'h2' : 'p';
---
<article class="ba" id={id} data-group={group} hidden={hidden} aria-live={id ? 'polite' : undefined}>
  <Tag class="d ba-out">{w.outcome}.</Tag>
  <div class="ba-panel"><p class="ba-tag">⏳ Before</p><p>{w.before}</p></div>
  <div class="ba-panel after"><p class="ba-tag">☀️ After</p><p>{w.after}</p></div>
  {hub && s && <a class="lnk ba-link" href={`${hub}/${s.slug}`}>More for {s.name[0].toLowerCase() + s.name.slice(1)}</a>}
</article>

<style>
  .ba { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2); background: var(--morning); border-radius: 20px; padding: clamp(24px, 4vw, 48px); }
  .ba[hidden] { display: none; }
  .ba-out { grid-column: 1 / -1; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.1; margin-bottom: var(--s2); }
  .ba-panel { background: #fff; border-radius: 12px; padding: var(--s4); display: grid; gap: 12px; align-content: start; font-size: 18px; line-height: 1.55; }
  .ba-panel.after { background: var(--ink); color: #fff; }
  .ba-tag { font-size: 15px; font-weight: 600; }
  .ba-link { grid-column: 1 / -1; justify-self: start; margin-top: var(--s1); }
  @media (max-width: 760px) { .ba { grid-template-columns: 1fr; } }
</style>
