---
// One industry or team page. Content comes from data/pages/<kind>/<slug>.ts.
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Pains from './Pains.astro';
import UseCaseSlides from './UseCaseSlides.astro';
import PactStrip from './PactStrip.astro';
import Faq from './Faq.astro';
import CloseCta from './CloseCta.astro';
import PilotPanel from './PilotPanel.astro';
import CaseStudyStrip from './CaseStudyStrip.astro';
import { site, industries, teams, type Segment } from '../data/site';
import type { SegmentPage } from '../data/segmentPages';
import { work } from '../data/home';

interface Props { kind: 'industries' | 'teams'; seg: Segment; page: SegmentPage }
const { kind, seg, page } = Astro.props;
const hub = kind === 'industries'
  ? { label: 'Industries', others: 'Other industries we work with' }
  : { label: 'Teams', others: 'Other teams we work with' };
const others = (kind === 'industries' ? industries : teams).filter((s) => s.slug !== seg.slug);
const url = `${site.url}/${kind}/${seg.slug}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: page.kicker,
    serviceType: 'AI implementation and training',
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url },
    areaServed: { '@type': 'Country', name: 'Singapore' },
    audience: { '@type': 'BusinessAudience', name: seg.name },
    description: page.description,
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: hub.label, item: `${site.url}/${kind}` },
      { '@type': 'ListItem', position: 3, name: seg.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.seoTitle} description={page.description} schema={schema}>
  <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={`/${kind}`}>{hub.label}</a> / <span aria-current="page">{seg.name}</span></nav>

  <PageHero kicker={page.kicker} title={page.title} lead={page.lead} secondary={{ label: 'See what changes', href: '#change' }} />

  <Pains title={page.painsTitle} items={page.pains} />

  <!-- The story: the work that wears the team down, what changes, proof it works, why people take to it,
       how to start, the last questions, then the call. -->
  <section class="section" id="change">
    <div class="wrap">
      <h2 class="d h2 sec-h">{page.changesTitle}</h2>
      <UseCaseSlides items={page.useCases} label={`${seg.name} use cases`} />
    </div>
  </section>

  <CaseStudyStrip kind={kind} slug={seg.slug} />

  <PactStrip title={page.people.title} body={page.people.body} />

  <section class="section start" id="start" aria-labelledby="start-h">
    <div class="wrap">
      <div class="start-head">
        <div class="start-copy">
          <h2 class="d h2" id="start-h">{page.start.title}</h2>
          <p class="lead muted">{page.start.body}</p>
        </div>
        <a class="btn btn-ink" href="/#start">See the ways to start</a>
      </div>
      <PilotPanel level="h3" />
    </div>
  </section>

  <Faq title={page.faqTitle} items={page.faq} tone="morning" />

  <nav class="section others-sec" aria-labelledby="others-h">
    <div class="wrap">
      <h2 class="h3 others-h" id="others-h">{hub.others}</h2>
      <ul class="others">
        {others.map((s) => <li><a class="chip" href={`/${kind}/${s.slug}`}><span aria-hidden="true">{work.icons[s.slug]}</span>{s.name}</a></li>)}
      </ul>
    </div>
  </nav>

  <CloseCta title={page.close.title} sub={page.close.sub} />
</Base>

<style>
  .crumbs { padding-top: var(--s3); font-size: 14px; color: var(--slate); }
  .crumbs a { color: var(--slate); }
  .sec-h { margin-bottom: var(--s5); max-width: 820px; }
  .start-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s4); flex-wrap: wrap; }
  .start-copy { display: grid; gap: var(--s2); max-width: 720px; }
  .others-sec { padding: var(--s5) 0; }
  .others-h { margin-bottom: var(--s3); }
  .others { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font: 500 15px var(--body); display: inline-flex; gap: 8px; align-items: center; padding: 10px 16px; border-radius: 99px; border: 1.5px solid var(--line); background: #fff; color: var(--ink); text-decoration: none; transition: border-color .15s; }
  .chip:hover { border-color: var(--ink); }
</style>
