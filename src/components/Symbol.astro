---
// The 4C Full Ring symbol. `tone` sets the dot colour; the sunrise stays orange.
interface Props { size?: number; tone?: 'ink' | 'white'; horizon?: boolean; class?: string }
const { size = 40, tone = 'ink', horizon = true, class: cls } = Astro.props;
const fill = tone === 'white' ? '#FFFFFF' : '#18213B';
const dots = [
  [42.47, 95.95, 1.8], [35.37, 91.52, 2.04], [29.36, 85.71, 2.27], [24.68, 78.78, 2.51],
  [21.55, 71.03, 2.75], [20.1, 62.79, 2.98], [20.39, 54.43, 3.22], [22.41, 46.32, 3.45],
  [26.08, 38.8, 3.69], [31.23, 32.21, 3.93], [37.63, 26.84, 4.16], [45.02, 22.91, 4.4],
];
---
<svg viewBox="0 0 120 120" width={size} height={size} aria-hidden="true" class={cls}>
  {dots.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} fill={fill} />)}
  <path d="M60,20 A40,40 0 0 1 60,100" fill="none" stroke="#FF7A3D" stroke-width="9" stroke-linecap="round" />
  {horizon && <rect x="6" y="58" width="108" height="4" fill={fill} />}
</svg>
