---
// The symbol scaled up into the horizon supergraphic. The horizon line runs full width
// and the ring sits centred on it, cropped by the right edge (as on the homepage board).
import Symbol from './Symbol.astro';
// rise: the one load moment. The dots (single prompts) appear one by one, then the sunrise arc joins them up.
interface Props { tone?: 'ink' | 'white'; rise?: boolean }
const { tone = 'ink', rise = false } = Astro.props;
---
<div class:list={['horizon', tone, { rise }]} aria-hidden="true">
  <Symbol size={120} tone={tone} horizon={false} class="ring" />
</div>
<style>
  /* --S (ring size) comes from the parent section, so the text beside it can keep clear. */
  .horizon { position: relative; height: 2px; background: var(--ink); }
  .horizon.white { background: rgba(255,255,255,.3); }
  .horizon :global(.ring) { position: absolute; width: var(--S, 400px); height: var(--S, 400px); right: calc(var(--S, 400px) * -0.29); top: calc(var(--S, 400px) / -2); pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .rise :global(circle) { animation: hh-dot .45s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(120ms + var(--i) * 55ms); transform-box: fill-box; transform-origin: center; }
    .rise :global(.arc) { stroke-dasharray: 1; animation: hh-arc 1.1s cubic-bezier(.65,0,.35,1) .8s both; }
  }
  @keyframes hh-dot { from { opacity: 0; transform: scale(.2); } }
  @keyframes hh-arc { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
</style>
