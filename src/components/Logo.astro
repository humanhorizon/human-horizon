---
import Symbol from './Symbol.astro';
interface Props { tone?: 'ink' | 'white' }
const { tone = 'ink' } = Astro.props;
---
<a href="/" class="logo" aria-label="Human Horizon, home">
  <Symbol size={40} tone={tone} />
  <span class="logo-word" style={`color:${tone === 'white' ? '#fff' : 'var(--ink)'}`}>Human Horizon</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; }
  .logo-word { font: 600 20px/1 var(--text); letter-spacing: -0.01em; white-space: nowrap; }
</style>
