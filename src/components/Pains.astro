---
// Four short pain cards on a morning section.
interface Props { title: string; items: { title: string; body: string }[] }
const { title, items } = Astro.props;
---
<section class="section bg-morning">
  <div class="wrap">
    <h2 class="d h2 sec-h">{title}</h2>
    <ul class="pains">
      {items.map((p) => <li><h3 class="h3">{p.title}</h3><p class="muted">{p.body}</p></li>)}
    </ul>
  </div>
</section>

<style>
  .sec-h { margin-bottom: var(--s5); max-width: 820px; }
  .pains { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s2); }
  .pains li { display: grid; gap: 12px; align-content: start; padding: var(--s4) var(--s3); background: #fff; border-radius: 20px; }
  @media (max-width: 1000px) { .pains { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .pains { grid-template-columns: 1fr; } }
</style>
