---
// A featured case study on the homepage: the usual card (logo on white, industry, headline, one line) with
// each headline figure as its own call-out underneath, so the numbers are read as results, not as text.
import type { CaseStudy, CaseWorkflow } from '../lib/caseStudies';
import { industries } from '../data/site';
interface Props { cs: CaseStudy }
const { cs } = Astro.props;
const d = cs.data;
const industry = industries.find((s) => s.slug === d.industry);
const pct = (w: CaseWorkflow) => `${(Math.min(Math.round((1 - w.time.afterMinutes / w.time.beforeMinutes) * 1000), 999) * 0.1).toFixed(1)}%`;
const rows = d.highlights.length
  ? d.highlights
  : d.workflows.slice(0, 3).map((w) => ({ figure: pct(w), label: `${w.result}: ${w.time.before} to ${w.time.after}` }));
---
<a class="css" href={`/case-studies/${cs.id}`}>
  <span class="head">
    <span class="logo">
      {d.logoStacked || d.logo ? <img src={d.logoStacked ?? d.logo} alt={d.client} loading="lazy" /> : <span class="d nm">{d.client}</span>}
    </span>
    <span class="body">
      <span class="meta"><span class="eyebrow">Case study</span>{industry && <span class="ind">{industry.name}</span>}</span>
      <h3 class="cname">{d.client}</h3>
      <span class="d h">{d.title}</span>
      <span class="sub">{d.subtitle}</span>
    </span>
  </span>
  <ul class="stats">
    {rows.map((r) => (
      <li><span class="d fig">{r.figure}</span><span class="lab">{r.label}</span></li>
    ))}
  </ul>
</a>

<style>
  .css { display: grid; gap: var(--s4); padding: clamp(24px, 3.2vw, 48px); border-radius: 28px; background: var(--morning); color: var(--ink); text-decoration: none; border: 1.5px solid transparent; transition: border-color .15s; }
  .css:hover { border-color: var(--ink); }
  .head { display: grid; grid-template-columns: clamp(104px, 11vw, 148px) minmax(0, 1fr); gap: clamp(20px, 2.4vw, 40px); align-items: center; }
  .logo { background: #fff; border: 1.5px solid var(--line); border-radius: 18px; aspect-ratio: 3 / 4; display: grid; place-items: center; padding: 14px; }
  .logo img { width: 100%; height: 100%; object-fit: contain; }
  .nm { font-size: 20px; text-align: center; }
  .body { display: grid; gap: 12px; max-width: 780px; }
  .meta { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .eyebrow { font-size: 14px; font-weight: 600; color: var(--sunrise-text); }
  .ind { font-size: 14px; font-weight: 600; padding: 4px 12px; border-radius: 99px; background: var(--first-light); color: var(--ink); }
  .cname { font-size: clamp(20px, 1.6vw, 24px); font-weight: 600; line-height: 1.2; margin: 0; }
  .h { font-size: clamp(24px, 2.2vw, 32px); line-height: 1.12; text-wrap: balance; }
  .sub { font-size: 17px; line-height: 1.5; color: var(--slate); }
  /* Each figure is its own call-out: big number, short label, on white. */
  .stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--s2); }
  .stats li { display: grid; gap: 10px; align-content: start; padding: var(--s3); border-radius: 20px; background: #fff; }
  .fig { font-size: clamp(40px, 3.6vw, 56px); line-height: 1; letter-spacing: -0.01em; }
  .lab { font-size: 15px; line-height: 1.45; color: var(--slate); }
  @media (max-width: 560px) {
    .head { grid-template-columns: 1fr; }
    .logo { width: 120px; aspect-ratio: 1; }
  }
</style>
