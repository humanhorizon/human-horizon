---
// Short method strip for inner pages: why the results last, the four PACT letters in order, and a link
// to /how-we-work. The method sits below the offer (YJ, 22 Nov 2026), so this stays one band, not a section lead.
import { pact } from '../data/home';
import { photo } from '../lib/photo';
const img = photo('method.jpg');
---
<section class="pstrip bg-ink">
  <div class:list={['wrap pgrid', { 'has-img': img }]}>
    {img && <img class="pimg" src={img} alt="A curved timber lattice canopy against the sky" loading="lazy" decoding="async" width="1200" height="900" />}
    <div class="ptext">
      <h2 class="d ph">{pact.title}</h2>
      <p class="muted">{pact.lead}</p>
      <a class="lnk" href="/how-we-work">How we work</a>
    </div>
    <ol class="letters" aria-label="The PACT">
      {pact.steps.map((st) => (
        <li><span class="letter d" aria-hidden="true">{st.letter}</span><span class="lt">{st.title}</span></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pstrip { padding: clamp(56px, 7vw, 96px) 0; }
  .pgrid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s5); align-items: center; }
  .ptext { display: grid; gap: var(--s2); justify-items: start; max-width: 560px; }
  .ph { font-size: clamp(28px, 2.6vw, 38px); }
  .pstrip .lnk { color: #fff; }
  .letters { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(96px, 1fr)); gap: var(--s1); }
  .letters li { display: grid; gap: 6px; padding: var(--s2); border-radius: 16px; background: var(--dusk); }
  .letter { font-size: clamp(36px, 3vw, 48px); line-height: .85; color: var(--sunrise); }
  .lt { font-size: 14px; font-weight: 600; line-height: 1.3; color: #fff; }
  /* With a photo: picture left, text and the four letters stacked on the right. */
  .has-img { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: stretch; }
  .has-img .ptext { align-content: center; }
  .has-img .letters { grid-column: 2; }
  .pimg { grid-row: span 2; width: 100%; height: 0; min-height: 100%; object-fit: cover; border-radius: 20px; filter: var(--photo-grade); }
  @media (max-width: 1000px) { .pgrid, .has-img { grid-template-columns: 1fr; } .has-img .letters { grid-column: auto; } .pimg { grid-row: auto; height: auto; aspect-ratio: 16 / 9; min-height: 0; } }
  @media (max-width: 520px) { .letters { grid-template-columns: 1fr 1fr; } }
</style>
