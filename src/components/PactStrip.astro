---
// Short method strip for inner pages: why the results last, the four PACT letters in order, and a link
// to /how-we-work. The method sits below the offer (YJ, 22 Nov 2026), so this stays one band, not a section lead.
// Each letter shows its one-line meaning on hover or keyboard focus. Bullets always run P, A, C, T.
import { pact } from '../data/home';
import { photo } from '../lib/photo';
const img = photo('teams/customer-service.jpg');
---
<section class="pstrip bg-ink">
  <div class:list={['wrap pgrid', { 'has-img': img }]}>
    {img && <img class="pimg" src={img} alt="A team lead and colleagues laughing as they work at their laptops" loading="lazy" decoding="async" width="1200" height="900" />}
    <div class="pmain">
      <div class="ptext">
        <h2 class="d ph">{pact.title}</h2>
        <p class="muted">{pact.lead}</p>
        <a class="lnk" href="/how-we-work">Our training methodology</a>
      </div>
      <ol class="letters" aria-label="The PACT">
        {pact.steps.map((st, i) => (
          <li tabindex="0" aria-describedby={`pact-tip-${i}`}>
            <span class="letter d" aria-hidden="true">{st.letter}</span>
            <span class="lt">{st.title}</span>
            <span class="tip" role="tooltip" id={`pact-tip-${i}`}>{st.body}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .pstrip { padding: clamp(72px, 8vw, 128px) 0; }
  .pgrid { display: grid; gap: var(--s5); align-items: center; }
  .pmain { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s5); align-items: center; }
  .ptext { display: grid; gap: var(--s2); justify-items: start; max-width: 560px; }
  .ph { font-size: clamp(28px, 2.6vw, 38px); }
  .pstrip .lnk { color: #fff; }
  .letters { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(96px, 1fr)); gap: var(--s1); }
  .letters li { position: relative; display: grid; gap: 6px; padding: var(--s2); border-radius: 16px; background: var(--dusk); cursor: default; transition: background .2s; }
  .letters li:hover, .letters li:focus-visible { background: #2c3a63; }
  .letter { font-size: clamp(36px, 3vw, 48px); line-height: .85; color: var(--sunrise); }
  .lt { font-size: 14px; font-weight: 600; line-height: 1.3; color: #fff; }

  /* One-line meaning above the tile, on hover or focus. */
  .tip { position: absolute; left: 50%; bottom: calc(100% + 10px); z-index: 2; width: max-content; max-width: 240px; padding: 10px 14px; border-radius: 12px; background: #fff; color: var(--ink); font-size: 14px; font-weight: 500; line-height: 1.45; box-shadow: 0 10px 30px rgba(10, 16, 34, .35); opacity: 0; visibility: hidden; transform: translate(-50%, 4px); pointer-events: none; }
  .tip::after { content: ''; position: absolute; left: 50%; top: 100%; transform: translateX(-50%); border: 7px solid transparent; border-top-color: #fff; }
  .letters li:hover .tip, .letters li:focus-visible .tip, .letters li:focus .tip { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: no-preference) { .tip { transition: opacity .18s ease, transform .18s ease, visibility .18s; } }

  /* With a photo: the picture on the left, text and letters stacked on the right. People, since the PACT is about people. */
  .has-img { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
  .has-img .pmain { grid-template-columns: 1fr; gap: var(--s4); }
  .pimg { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 20px; filter: var(--photo-grade); }
  @media (max-width: 1000px) { .pgrid, .has-img, .pmain { grid-template-columns: 1fr; } .pimg { aspect-ratio: 16 / 9; } }
  @media (max-width: 520px) {
    .letters { grid-template-columns: 1fr 1fr; }
    .tip { max-width: 180px; }
    .letters li:nth-child(odd) .tip { left: 0; transform: translate(0, 4px); }
    .letters li:nth-child(even) .tip { left: auto; right: 0; transform: translate(0, 4px); }
    .letters li:nth-child(odd):is(:hover, :focus) .tip, .letters li:nth-child(even):is(:hover, :focus) .tip { transform: translate(0, 0); }
    .letters li:nth-child(odd) .tip::after { left: 28px; }
    .letters li:nth-child(even) .tip::after { left: auto; right: 14px; transform: none; }
  }
</style>
