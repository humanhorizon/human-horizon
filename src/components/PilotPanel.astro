---
// A call-to-action panel over an architecture photograph (public/pilot.jpg). By default it carries the
// founding clients offer; industry and team pages pass their own first step and the usual call CTA.
// Until the photo exists, a deep ink gradient holds the space.
import { existsSync } from 'node:fs';
import { site } from '../data/site';
interface Props {
  level?: 'h2' | 'h3';
  eyebrow?: string;
  title?: string;
  text?: string;
  cta?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  level = 'h2',
  eyebrow = 'Founding clients',
  title = site.pilot.title,
  text = site.pilot.text,
  cta = { label: site.pilot.link, href: site.pilot.href },
  secondary,
} = Astro.props;
const H = level;
const photo = existsSync(new URL('../../public/pilot.jpg', import.meta.url)) ? 'url(/pilot.jpg)' : 'none';
---
<div class="pilot" style={`--photo: ${photo}`}>
  <div class="copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <H class="d h2">{title}</H>
    <p class="body">{text}</p>
  </div>
  <div class="acts">
    <a class="btn btn-sun" href={cta.href}>{cta.label}</a>
    {secondary && <a class="lnk sec" href={secondary.href}>{secondary.label}</a>}
  </div>
</div>

<style>
  .pilot {
    margin-top: var(--s5); padding: clamp(32px, 6vw, 88px) clamp(24px, 5vw, 72px); border-radius: 20px; color: #fff;
    display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s4); flex-wrap: wrap;
    background: linear-gradient(100deg, rgba(24, 33, 59, .92) 0%, rgba(24, 33, 59, .72) 55%, rgba(24, 33, 59, .35) 100%), var(--photo) center / cover no-repeat, var(--dusk);
    min-height: 380px;
  }
  .copy { display: grid; gap: var(--s2); max-width: 680px; }
  .copy .h2 { font-size: clamp(28px, 2.7vw, 35px); line-height: 1.12; text-wrap: balance; }
  .eyebrow { font-size: 15px; font-weight: 600; color: var(--sunrise); }
  .body { font-size: 18px; line-height: 1.55; color: var(--on-ink); }
  .acts { display: grid; gap: var(--s2); justify-items: start; }
  .sec { color: #fff; font-size: 15px; }
</style>
