---
import Logo from './Logo.astro';
import { pillars, industries, teams, site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap grid">
    <div>
      <Logo />
      <p class="muted blurb">{site.boilerplate}</p>
      <p class="muted blurb"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div><p class="t">What we do</p>{pillars.map((p) => <a href={`/what-we-do/${p.slug}`}>{p.name}</a>)}<a href="/ai-course-singapore">AI course or training</a></div>
    <div><p class="t">Industries</p>{industries.slice(0, 6).map((s) => <a href={`/industries/${s.slug}`}>{s.name}</a>)}<a href="/industries">All industries</a></div>
    <div><p class="t">Teams</p>{teams.map((s) => <a href={`/teams/${s.slug}`}>{s.name}</a>)}</div>
    <div><p class="t">Company</p><a href="/about">About</a><a href="/insights">Insights</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div>
  </div>
  <div class="wrap legal cap">© {year} Human Horizon. Singapore.</div>
</footer>
<style>
  .ftr { padding: var(--s5) 0 var(--s4); border-top: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1.4fr repeat(4, 1fr); gap: var(--s4); font-size: 15px; line-height: 1.5; }
  .grid a { display: block; color: var(--slate); text-decoration: none; padding: 4px 0; }
  .grid a:hover { color: var(--ink); }
  .t { font-weight: 600; margin-bottom: 8px; }
  .blurb { margin-top: var(--s2); max-width: 300px; }
  .blurb a { padding: 0; }
  .legal { margin-top: var(--s5); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } .grid > div:first-child { grid-column: 1 / -1; } }
</style>
