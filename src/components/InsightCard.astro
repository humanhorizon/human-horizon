---
// One Insights item as a card. `feature` lays the cover beside the text for the lead story;
// `card` stacks it above; `row` drops the cover for compact lists.
import Cover from './Cover.astro';
import { fmtDate, type Card } from '../lib/insights';

interface Props { item: Card; layout?: 'feature' | 'card' | 'row'; headingLevel?: 'h2' | 'h3' }
const { item, layout = 'card', headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class:list={['ic', layout]} data-type={item.type} data-category={item.categorySlug}>
  {layout !== 'row' && <Cover category={item.categorySlug} art={item.art} size={layout === 'feature' ? 'lg' : 'md'} />}
  <div class="ic-body">
    <p class="ic-meta"><span class="badge">{item.typeLabel}</span><span class="cat">{item.category}</span></p>
    <H class="d ic-title"><a href={item.href}>{item.title}</a></H>
    <p class="muted ic-desc">{item.description}</p>
    {item.type !== 'glossary' && <p class="cap"><time datetime={item.date.toISOString().slice(0, 10)}>{fmtDate(item.date)}</time></p>}
  </div>
</article>

<style>
  .ic { position: relative; display: grid; gap: var(--s2); align-content: start; padding: 12px; border-radius: 24px; background: var(--white); border: 1px solid var(--line); transition: border-color .15s, transform .15s; }
  .ic:hover { border-color: var(--ink); }
  .ic:focus-within { border-color: var(--sunrise-text); }
  .ic-body { display: grid; gap: 10px; align-content: start; padding: 4px 12px 14px; }
  .ic-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 14px; font-weight: 500; }
  .badge { padding: 3px 12px; border-radius: 999px; background: var(--first-light); color: var(--ink); }
  .cat { color: var(--slate); }
  .ic-title { font-size: clamp(24px, 2.2vw, 30px); line-height: 1.12; text-wrap: balance; }
  .ic-title a { text-decoration: none; color: inherit; }
  /* The whole card is one link target; the title link stretches over it. */
  .ic-title a::after { content: ''; position: absolute; inset: 0; border-radius: 24px; }
  .ic-desc { font-size: 16px; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .feature { grid-template-columns: 1.15fr 1fr; gap: var(--s3); padding: 12px; }
  .feature .ic-body { align-content: center; gap: var(--s2); padding: var(--s3) var(--s3) var(--s3) 0; }
  .feature .ic-title { font-size: clamp(32px, 3.6vw, 52px); line-height: 1.05; }
  .feature .ic-desc { font-size: 18px; -webkit-line-clamp: 4; }

  .row { border-radius: 0; border: 0; border-top: 1px solid var(--line); padding: var(--s3) 0; }
  .row:hover { border-color: var(--line); }
  .row .ic-body { padding: 0; }
  .row .ic-title a::after { border-radius: 0; }

  @media (max-width: 860px) {
    .feature { grid-template-columns: 1fr; }
    .feature .ic-body { padding: 4px 12px 14px; }
  }
</style>
