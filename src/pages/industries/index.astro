---
import HubView from '../../components/HubView.astro';
import { industries } from '../../data/site';
import { industryPages } from '../../data/segmentPages';

const copy = {
  seoTitle: 'AI for Singapore industries | Human Horizon',
  description: 'People-first AI for Singapore businesses in 13 industries, from agencies and recruiters to logistics, law, healthcare and facilities. See what changes in yours.',
  kicker: 'AI for Singapore businesses, by industry',
  title: 'Whatever your trade, nobody gets left behind.',
  lead: 'Every industry has its own grind: the quotes, the reports, the chasing and the retyping that wear good people down. Pick yours to see what changes when AI takes that on and your people stay in charge.',
  listTitle: 'Pick your industry',
  people: {
    title: 'Every trade changes through its people.',
    body: 'Whatever your industry, the people who do the work know where it hurts. They hear first what AI means for their roles, help shape what changes and keep the final say.',
  },
  faqTitle: 'Questions about AI in your industry',
  faq: [
    { q: 'Which industries do you work with?', a: 'We work with Singapore businesses in marketing and creative agencies, recruitment, trading and distribution, logistics and freight, accounting and corporate secretarial, interior design, education, cleaning and facilities, law, property, engineering and M&E, and IT services. If yours is not listed, talk to us anyway. Any business with recurring work to get through is worth a conversation.' },
    { q: 'Does AI work the same way in every industry?', a: 'No. Every field has its own work, documents and rules, so we start with your team and how they work today. That is why each industry page names the work of that trade, from freight quotes to variation claims.' },
    { q: 'What kind of work is a good fit for AI?', a: 'Recurring work that follows a pattern: quotes, reports, proposals, documents, status updates, scheduling and replies to common questions. A person still checks the output and makes the judgement calls.' },
    { q: 'How do we start?', a: 'With a 30-minute conversation about the work that takes up your team’s week. Drop us an email at contact.humanhorizon@gmail.com.', links: [{ label: 'Email us', href: 'mailto:contact.humanhorizon@gmail.com' }] },
  ],
};
---
<HubView kind="industries" items={industries} pages={industryPages} copy={copy} />
