---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { contact } from '../data/companyPages';
const f = contact.form;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: contact.seoTitle,
    url: `${site.url}/contact`,
    mainEntity: { '@type': 'ProfessionalService', name: site.name, url: site.url, email: site.email, areaServed: { '@type': 'Country', name: 'Singapore' } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact` },
    ],
  },
];
---
<Base title={contact.seoTitle} description={contact.description} schema={schema}>
  <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Contact</span></nav>

  <PageHero kicker={contact.kicker} title={contact.title} lead={contact.lead} />

  <section class="section pt0" id="form">
    <div class="wrap">
      <div class="mail">
        <div class="stack intro">
          <h2 class="h3">{f.title}</h2>
          <p class="muted">{f.note}</p>
          <div class="alt">
            <p class="cap">{contact.emailNote}</p>
            <a class="addr" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>

        <!-- Netlify Forms: detected at deploy from this static HTML. Spam layers: the hidden "website" field
             (netlify-honeypot), Netlify's built-in spam filter, and the checks in the script below. -->
        <form class="cform" name="contact" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="website" data-contact-form>
          <input type="hidden" name="form-name" value="contact" />
          <p class="trap" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label></p>

          <div class="row2">
            <label class="fld"><span>Name</span><input name="name" required autocomplete="name" maxlength="120" /></label>
            <label class="fld"><span>Work email</span><input type="email" name="email" required autocomplete="email" maxlength="160" /></label>
          </div>
          <div class="row2">
            <label class="fld"><span>Company</span><input name="company" required autocomplete="organization" maxlength="160" /></label>
            <label class="fld"><span>Team size</span>
              <select name="team-size" required><option value="" disabled selected>Choose one</option>{f.sizes.map((x) => <option>{x}</option>)}</select>
            </label>
          </div>
          <div class="row2">
            <label class="fld"><span>Role</span>
              <select name="role" required><option value="" disabled selected>Choose one</option>{f.roles.map((x) => <option>{x}</option>)}</select>
            </label>
            <label class="fld"><span>Topic</span>
              <select name="topic" required data-topic>{f.topics.map((t, i) => <option value={t.label} data-key={t.value} selected={i === 0}>{t.label}</option>)}</select>
            </label>
          </div>
          <label class="fld"><span>{f.messageLabel}</span>
            <textarea name="message" required minlength="20" maxlength="3000" rows="5" placeholder={f.messageHint}></textarea>
          </label>
          <p class="err" role="alert" hidden data-err>{f.linkError}</p>
          <div class="send">
            <button class="btn btn-ink" type="submit">{f.submit}</button>
            <p class="cap">{f.consent} See our <a href="/privacy">privacy notice</a>.</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="section bg-morning">
    <div class="wrap">
      <h2 class="d h2 sec-h">{contact.stepsTitle}</h2>
      <ol class="steps">
        {contact.steps.map((s, i) => <li><span class="n">{i + 1}</span><h3 class="h3">{s.title}</h3><p class="muted">{s.body}</p></li>)}
      </ol>
      <p class="loc muted">{contact.location}</p>
    </div>
  </section>
</Base>

<script>
  // Prefill the topic from ?topic= (call, founding, other), and stop messages stuffed with links,
  // a common spam pattern, before they are sent.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const key = new URLSearchParams(location.search).get('topic');
    const sel = form.querySelector<HTMLSelectElement>('[data-topic]');
    const match = key && sel ? [...sel.options].find((o) => o.dataset.key === key) : undefined;
    if (match && sel) sel.value = match.value;
    const err = form.querySelector<HTMLElement>('[data-err]');
    form.addEventListener('submit', (e) => {
      const msg = (form.elements.namedItem('message') as HTMLTextAreaElement).value;
      const links = (msg.match(/https?:\/\/|www\./gi) || []).length;
      if (links > 2) { e.preventDefault(); if (err) err.hidden = false; }
    });
  }
</script>

<style>
  .crumbs { padding-top: var(--s3); font-size: 14px; color: var(--slate); }
  .crumbs a { color: var(--slate); }
  .pt0 { padding-top: 0; }
  #form { scroll-margin-top: 64px; }
  .mail { padding: clamp(24px, 4vw, 56px); border-radius: 20px; background: var(--first-light); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .intro { gap: var(--s2); }
  .alt { display: grid; gap: 4px; margin-top: var(--s2); }
  .addr { font-weight: 600; text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .addr:hover { color: var(--sunrise-text); }
  .cform { display: grid; gap: var(--s2); background: #fff; border-radius: 16px; padding: clamp(20px, 3vw, 32px); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2); }
  .fld { display: grid; gap: 6px; font-size: 14px; font-weight: 600; }
  .fld input, .fld select, .fld textarea { font: 400 16px/1.4 var(--text); color: var(--ink); background: #fff; border: 1.5px solid var(--line); border-radius: 10px; padding: 11px 12px; width: 100%; }
  .fld textarea { resize: vertical; min-height: 120px; }
  .fld input:focus, .fld select:focus, .fld textarea:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px var(--first-light); }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .err { color: #B3261E; font-size: 14px; }
  .send { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }
  .send .cap a { color: inherit; }
  .sec-h { margin-bottom: var(--s5); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s2); }
  .steps li { display: grid; gap: 12px; align-content: start; padding: var(--s4) var(--s3); background: #fff; border-radius: 20px; }
  .n { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: #fff; font-weight: 600; font-size: 15px; }
  .loc { margin-top: var(--s4); }
  @media (max-width: 1000px) { .steps { grid-template-columns: 1fr; } .mail { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .row2 { grid-template-columns: 1fr; } }
</style>
