---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PillarCards from '../../components/PillarCards.astro';
import PactStrip from '../../components/PactStrip.astro';
import Faq from '../../components/Faq.astro';
import CloseCta from '../../components/CloseCta.astro';
import PilotPanel from '../../components/PilotPanel.astro';
import { site, pillars } from '../../data/site';
import { close, hero } from '../../data/home';
import { whatWeDoHub as hub } from '../../data/pillarPages';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: hub.kicker,
    itemListElement: pillars.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: `${site.url}/what-we-do/${p.slug}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'What we do', item: `${site.url}/what-we-do` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: hub.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={hub.seoTitle} description={hub.description} schema={schema}>
  <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">What we do</span></nav>

  <PageHero kicker={hub.kicker} title={hub.title} lead={hub.lead} secondary={{ label: 'See the three parts', href: '#pillars' }} note={hero.credibility} />

  <section class="section bg-morning" id="pillars">
    <div class="wrap">
      <div class="head stack"><h2 class="d h2">{hub.pillarsTitle}</h2><p class="lead muted">{hub.pillarsLead}</p></div>
      <PillarCards />
    </div>
  </section>

  <PactStrip title={hub.people.title} body={hub.people.body} />

  <Faq title={hub.faqTitle} items={hub.faq} tone="morning" />

  <section class="pilot-sec"><div class="wrap"><PilotPanel /></div></section>

  <CloseCta title={close.title} sub={close.sub} />
</Base>

<style>
  .crumbs { padding-top: var(--s3); font-size: 14px; color: var(--slate); }
  .crumbs a { color: var(--slate); }
  .pilot-sec { padding: 0 0 var(--section); }
  .head { max-width: 720px; gap: var(--s2); margin-bottom: var(--s5); }
</style>
