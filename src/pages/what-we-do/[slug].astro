---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pains from '../../components/Pains.astro';
import UseCaseSlides from '../../components/UseCaseSlides.astro';
import PactStrip from '../../components/PactStrip.astro';
import Faq from '../../components/Faq.astro';
import CloseCta from '../../components/CloseCta.astro';
import PilotPanel from '../../components/PilotPanel.astro';
import { site, pillars, industries, teams } from '../../data/site';
import { pillarPages } from '../../data/pillarPages';
import { hero } from '../../data/home';
import { industryPages, teamPages } from '../../data/segmentPages';

export function getStaticPaths() {
  return pillars.filter((p) => pillarPages[p.slug]).map((p) => ({ params: { slug: p.slug }, props: { pillar: p, page: pillarPages[p.slug] } }));
}

const { pillar, page } = Astro.props;
const others = pillars.filter((p) => p.slug !== pillar.slug);
const heroLink: Record<string, string> = { implement: 'See what we implement', train: 'See what training includes', adopt: 'See what adoption includes' };
const url = `${site.url}/what-we-do/${pillar.slug}`;
// Use cases are borrowed from industry and team pages, so the pillar page links into them.
const cases = page.useCases.map((r) => {
  const name = (r.kind === 'industries' ? industries : teams).find((x) => x.slug === r.slug)!.name;
  return { ...(r.kind === 'industries' ? industryPages : teamPages)[r.slug].useCases[r.index], href: `/${r.kind}/${r.slug}`, source: name[0].toLowerCase() + name.slice(1) };
});

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: page.kicker,
    serviceType: pillar.name === 'Implement' ? 'AI implementation' : pillar.name === 'Train' ? 'AI training' : 'AI adoption',
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url },
    areaServed: { '@type': 'Country', name: 'Singapore' },
    description: page.description,
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'What we do', item: `${site.url}/what-we-do` },
      { '@type': 'ListItem', position: 3, name: pillar.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.seoTitle} description={page.description} schema={schema}>
  <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/what-we-do">What we do</a> / <span aria-current="page">{pillar.name}</span></nav>

  <PageHero kicker={page.kicker} title={page.title} lead={page.lead} secondary={{ label: heroLink[pillar.slug] ?? 'See what is included', href: '#deliverables' }} note={hero.credibility} />

  <Pains title={page.painsTitle} items={page.pains} />

  <section class="section bg-ink" id="deliverables">
    <div class="wrap">
      <h2 class="d h2 sec-h">{page.deliverablesTitle}</h2>
      <ul class="dlv">
        {page.deliverables.map((d) => <li><h3 class="d h3d">{d.name}</h3><p class="muted">{d.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="d h2 sec-h">{page.useCasesTitle}</h2>
      <UseCaseSlides items={cases} label={`${pillar.name} use cases`} />
      <p class="more">More examples by <a class="lnk" href="/industries">industry</a> and by <a class="lnk" href="/teams">team</a>.</p>
    </div>
  </section>

  <PactStrip title={page.people.title} body={page.people.body} />

  <Faq title={page.faqTitle} items={page.faq} tone="morning" />

  <section class="section">
    <div class="wrap">
      <h2 class="h3 others-h">The other parts of the change</h2>
      <ul class="others">
        {others.map((p) => <li><a href={`/what-we-do/${p.slug}`}><span class="d h3d">{p.name}</span><span class="muted">{p.outcome}</span></a></li>)}
      </ul>
      <PilotPanel />
    </div>
  </section>

  <CloseCta title={page.close.title} sub={page.close.sub} />
</Base>

<style>
  .crumbs { padding-top: var(--s3); font-size: 14px; color: var(--slate); }
  .crumbs a { color: var(--slate); }
  .sec-h { margin-bottom: var(--s5); max-width: 820px; }
  .dlv { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4) var(--s5); }
  .dlv li { display: grid; gap: 10px; align-content: start; padding: var(--s3) 0 0 28px; border-top: 1px solid rgba(255, 255, 255, .22); position: relative; }
  .dlv li::before { content: ''; position: absolute; left: 0; top: calc(var(--s3) + .55em); width: 10px; height: 10px; border-radius: 50%; background: var(--sunrise); }
  .more { margin-top: var(--s3); color: var(--slate); }
  .others-h { margin-bottom: var(--s3); }
  .others { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2); }
  .others a { display: grid; gap: 8px; padding: var(--s4); border-radius: 20px; background: var(--first-light); text-decoration: none; transition: box-shadow .15s; }
  .others a:hover { box-shadow: inset 0 0 0 2px var(--sunrise); }
  @media (max-width: 760px) { .dlv, .others { grid-template-columns: 1fr; } }
</style>
