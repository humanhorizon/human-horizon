---
// How we work: the people-first method (the PACT) behind every engagement. Linked from the homepage,
// What we do, the method strip on inner pages and the footer. PACT bullets always run P, A, C, T.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CloseCta from '../components/CloseCta.astro';
import { close, hero } from '../data/home';
import { howWeWork as page } from '../data/companyPages';

---
<Base title={page.seoTitle} description={page.description}>
  <PageHero kicker={page.kicker} title={page.title} lead={page.lead} secondary={{ label: 'See the four commitments', href: '#pact' }} note={hero.credibility} />

  <section class="pact-sec bg-ink" id="pact">
    <div class="wrap">
      <div class="two">
        <h2 class="d h2">{page.pactTitle}</h2>
        <p class="lead muted">{page.pactLead}</p>
      </div>
      <ol class="pact">
        {page.pact.map((st) => (
          <li>
            <span class="letter d" aria-hidden="true">{st.letter}</span>
            <h3 class="h3">{st.title}</h3>
            <p class="muted">{st.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="d h2 narrow">{page.stepsTitle}</h2>
      <p class="lead muted sub">{page.stepsLead}</p>
      <ol class="steps">
        {page.steps.map((s, i) => (
          <li>
            <span class="n">{i + 1}</span>
            <div>
              <h3 class="h3">{s.href ? <a href={s.href}>{s.name}</a> : s.name}</h3>
              <p class="muted">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="proof"><a class="lnk" href={page.proof.href}>{page.proof.label}</a></p>
    </div>
  </section>

  <Faq title="Questions about how we work" items={page.faq} />

  <CloseCta title={close.title} sub={close.sub} />
</Base>

<style>
  .pact-sec { padding: var(--section) 0; }
  .pact { list-style: none; margin: var(--s6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s2); }
  .pact li { display: grid; gap: 10px; align-content: start; padding: var(--s4) var(--s3); border-radius: 20px; background: var(--dusk); }
  .letter { font-size: clamp(77px, 7.7vw, 118px); line-height: .85; color: var(--sunrise); margin-bottom: var(--s3); }
  .pact .h3 { color: #fff; }
  .narrow { max-width: 820px; }
  .sub { max-width: 640px; margin-top: var(--s2); }
  /* The engagement really is a sequence, so the steps are numbered. */
  .steps { list-style: none; margin: var(--s5) 0 var(--s4); padding: 0; display: grid; gap: 0; max-width: 860px; }
  .steps li { display: grid; grid-template-columns: 56px 1fr; gap: var(--s3); padding: var(--s3) 0; border-top: 1px solid var(--line); }
  .steps li:last-child { border-bottom: 1px solid var(--line); }
  .n { font: 300 36px/1 var(--display); color: var(--sunrise-text); }
  .steps .h3 a { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
  .steps p { margin-top: 6px; max-width: 62ch; }
  @media (max-width: 1000px) { .pact { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .pact { grid-template-columns: 1fr; } }
</style>
