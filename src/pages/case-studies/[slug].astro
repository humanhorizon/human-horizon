---
// One case study. The page is built around one idea: how long the work used to take. Each workflow
// shows its before and after time as two bars to scale, then the team as it works now (people first,
// then the AI assistants), then the story told as Implement, Train, Adopt.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CloseCta from '../../components/CloseCta.astro';
import { site, industries, teams } from '../../data/site';
import { close } from '../../data/home';
import { getCaseStudies, type CaseStudy, type CaseWorkflow } from '../../lib/caseStudies';
import '../../styles/prose.css';

export async function getStaticPaths() {
  return (await getCaseStudies()).map((cs) => ({ params: { slug: cs.id }, props: { cs } }));
}

const { cs } = Astro.props as { cs: CaseStudy };
const { Content, headings } = await render(cs);
const d = cs.data;
const url = `${site.url}/case-studies/${cs.id}`;
const industry = industries.find((s) => s.slug === d.industry);
const teamOf = (slug: string) => teams.find((t) => t.slug === slug);
const caseTeams = d.teams.map(teamOf).filter((t) => t !== undefined);
const lower = (s: string) => s[0].toLowerCase() + s.slice(1);
const iso = (x: Date) => `${x.toISOString().slice(0, 10)}T00:00:00+08:00`;
// The after bar is drawn to scale, with a floor so a few minutes against days is still visible.
const share = (w: CaseWorkflow) => Math.max((w.time.afterMinutes / w.time.beforeMinutes) * 100, 0.8);
// Time saved against working hours, to one decimal, capped at 99.9% so it never reads as 100%.
const pct = (w: CaseWorkflow) => {
  const ratio = w.time.afterMinutes / w.time.beforeMinutes;
  const tenths = Math.min(Math.round((1 - ratio) * 1000), 999);
  return `${(tenths * 0.1).toFixed(1)}%`;
};
const contents = headings.filter((h) => h.depth === 2);
const totalAgents = d.team?.assistants.length || d.workflows.reduce((n, w) => n + w.agents, 0);
const serviceNames = { implement: 'AI implementation', train: 'AI training', adopt: 'AI adoption' } as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${d.client}: ${d.title}`,
    description: d.description,
    datePublished: iso(d.date),
    dateModified: iso(d.updated ?? d.date),
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: { '@type': 'Organization', name: site.name, url: site.url, logo: { '@type': 'ImageObject', url: `${site.url}/logo/human-horizon-horizontal-full-colour.svg` } },
    about: { '@type': 'Organization', name: d.client, ...(d.website && { url: d.website }), description: d.about },
    mainEntityOfPage: url,
    image: `${site.url}/og.png`,
    articleSection: 'Case studies',
    inLanguage: 'en-SG',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Case studies', item: `${site.url}/case-studies` },
      { '@type': 'ListItem', position: 3, name: d.client, item: url },
    ],
  },
];
---
<Base title={d.seoTitle} description={d.description} schema={schema} ogType="article">
  {!d.publish && <p class="draft-bar">Draft: shown on the dev server only. It goes live once the client approves and YJ ticks Approve to publish.</p>}
  <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/case-studies">Case studies</a> / <span aria-current="page">{d.client}</span></nav>

  <header class="wrap hero">
    <div class="hero-text">
      <h1 class="d h1 hero-h"><span class="kicker">AI case study: {d.client}</span><span class="sr-only">: </span>{d.title}</h1>
      <p class="lead muted">{d.summary}</p>
      <ul class="results" aria-label="Results">
        {d.workflows.map((w) => <li><p class="d r-n">{pct(w)}</p><p class="r-l">{w.result}</p></li>)}
        <li><p class="d r-n">{d.workflows.length}</p><p class="r-l">AI workflows implemented</p></li>
        <li><p class="d r-n">{totalAgents}</p><p class="r-l">AI agents designed</p></li>
      </ul>
    </div>
    <aside class="client" aria-label="About the client">
      {d.logo ? <img class="client-logo" src={d.logo} alt={d.client} /> : <p class="d client-name">{d.client}</p>}
      <p class="client-about">{d.about}</p>
      <dl class="client-facts">
        {industry && <div><dt>Industry</dt><dd><a href={`/industries/${industry.slug}`}>{industry.name}</a></dd></div>}
        {caseTeams.length > 0 && <div><dt>Teams</dt><dd>{caseTeams.map((t, i) => <>{i > 0 && ', '}<a href={`/teams/${t.slug}`}>{t.name}</a></>)}</dd></div>}
        {d.services.length > 0 && <div><dt>What we did</dt><dd>{d.services.map((sv, i) => <>{i > 0 && ', '}<a href={`/what-we-do/${sv}`}>{serviceNames[sv]}</a></>)}</dd></div>}
        {d.tools.length > 0 && <div><dt>AI tools</dt><dd>{d.tools.join(', ')}</dd></div>}
        {d.website && <div><dt>Website</dt><dd><a href={d.website} rel="noopener">{d.website.replace(/^https?:\/\//, '')}</a></dd></div>}
      </dl>
    </aside>
  </header>

  <section class="section flows" aria-labelledby="flows-h" id="workflows">
    <div class="wrap">
      <h2 class="d h2 sec-h" id="flows-h">How each workflow changed</h2>
      <div class="wfl">
        {d.workflows.map((w, i) => {
          const t = teamOf(w.team);
          return (
            <details class="wf" open={i === 0} data-toggle="before">
              <summary>
                <span class="wf-head">
                  <span class="d wf-name">{w.name}</span>
                  <span class="wf-line">{w.summary.now}</span>
                </span>
                <span class="wf-pct"><span class="d">{pct(w)}</span> less time</span>
                <span class="wf-chev" aria-hidden="true"></span>
              </summary>
              <div class="wf-body">
                <div class="wf-copy">
                  <div class="seg" role="group" aria-label={`Show ${lower(w.name)} before or now`}>
                    <button type="button" data-show="before" aria-pressed="true">Before</button>
                    <button type="button" data-show="now" aria-pressed="false">Now</button>
                  </div>
                  <div class="wf-state" data-when="before">
                    <p class="d wf-sum">{w.summary.before}</p>
                    <p class="wf-detail">{w.before}</p>
                  </div>
                  <div class="wf-state" data-when="now">
                    <p class="d wf-sum">{w.summary.now}</p>
                    <p class="wf-detail">{w.after}</p>
                    <p class="wf-people"><strong>Where the time goes now:</strong> {w.people}</p>
                  </div>
                  {t && <a class="lnk wf-team" href={`/teams/${t.slug}`}>More AI for {lower(t.name)}</a>}
                </div>
                <div class="wf-time" aria-label={`${w.time.before} before, ${w.time.after} now, ${w.time.unit}`}>
                  <div class="wt-row" data-bar="before">
                    <p class="wt-lab">Before</p>
                    <p class="d wt-val">{w.time.before}</p>
                    <span class="bar-track" aria-hidden="true"><span class="bar bar-before" style="width: 100%"></span></span>
                  </div>
                  <div class="wt-row" data-bar="now">
                    <p class="wt-lab">Now</p>
                    <p class="d wt-val">{w.time.after}</p>
                    <span class="bar-track" aria-hidden="true"><span class="bar bar-after" style={`width: ${share(w)}%`}></span></span>
                  </div>
                  <p class="wt-pct"><span class="d">{pct(w)}</span> less time {w.time.unit}</p>
                </div>
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </section>

  {d.team && (
    <section class="section bg-morning" aria-labelledby="team-h">
      <div class="wrap" data-toggle="now">
        <div class="team-head">
          <h2 class="d h2" id="team-h">How the team changed</h2>
          <div class="seg seg-white" role="group" aria-label="Show the team before or now">
            <button type="button" data-show="before" aria-pressed="false">Before</button>
            <button type="button" data-show="now" aria-pressed="true">Now</button>
          </div>
        </div>
        <div class="org">
          {d.team.now.map((m) => {
            const then = d.team!.then.find((t) => t.role === m.role);
            const reports = d.team!.assistants.filter((a) => a.reportsTo === m.role);
            return (
              <div class="org-col">
                <div class="org-staff">
                  <p class="org-role">{m.role}</p>
                  {then && <p class="org-text" data-when="before">{then.did}</p>}
                  <p class="org-text" data-when="now">{m.does}</p>
                </div>
                {reports.length > 0 && (
                  <ul class="org-ai" data-when="now" aria-label={`AI assistants reporting to ${lower(m.role)}`}>
                    {reports.map((a) => <li><p class="org-ai-name">{a.name}</p><p class="muted">{a.does}</p></li>)}
                  </ul>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap story">
      {contents.length > 0 && (
        <nav class="toc" aria-label="The transformation">
          <p class="toc-h">The transformation</p>
          <ol>{contents.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <article class="prose story-text"><Content /></article>
    </div>
  </section>

  <CloseCta title={close.title} sub={close.sub} />
</Base>

<script>
  // Before/Now switches. Each [data-toggle] block starts in the state it names (workflows open on Before,
  // the team on Now); the switch changes the text and the highlighted bar together. Without JavaScript
  // both states stay visible.
  for (const box of document.querySelectorAll<HTMLElement>('[data-toggle]')) {
    box.dataset.state = box.dataset.toggle;
    box.querySelector('.seg')?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-show]');
      if (!b) return;
      box.dataset.state = b.dataset.show!;
      box.querySelectorAll('.seg button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    });
  }
</script>

<style>
  .draft-bar { background: var(--first-light); text-align: center; padding: 10px var(--gutter); font-size: 14px; font-weight: 600; }
  .crumbs { padding-top: var(--s3); font-size: 14px; color: var(--slate); }
  .crumbs a { color: var(--slate); }

  /* Hero: the claim on the left, the client on the right. */
  .hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px); align-items: end; padding-top: clamp(40px, 6vw, 88px); padding-bottom: clamp(48px, 6vw, 88px); }
  .hero-text { display: grid; gap: var(--s4); }
  .hero-h { text-wrap: balance; }
  .kicker { display: block; margin-bottom: var(--s3); font: 600 17px/1.4 var(--body); letter-spacing: 0; color: var(--sunrise-text); }
  .client { background: var(--morning); border-radius: 20px; padding: clamp(24px, 3vw, 40px); display: grid; gap: var(--s2); }
  .client-name { font-size: clamp(30px, 2.8vw, 40px); line-height: 1.05; }
  .client-logo { height: 56px; width: auto; justify-self: start; }
  .client-about { font-size: 16px; line-height: 1.55; }
  .client-facts { margin: var(--s1) 0 0; display: grid; gap: 12px; border-top: 1px solid var(--line); padding-top: var(--s2); }
  .client-facts > div { display: grid; grid-template-columns: 96px 1fr; gap: var(--s2); font-size: 15px; line-height: 1.5; }
  .client-facts dt { color: var(--slate); font-weight: 500; }
  .client-facts dd { margin: 0; }

  /* Header results: quiet figures in ink, so the headline stays the first thing read. */
  .results { list-style: none; margin: var(--s1) 0 0; padding: var(--s3) 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--s3); }
  .r-n { font-size: clamp(30px, 2.6vw, 38px); line-height: 1; }
  .r-l { margin-top: 8px; font-size: 14px; line-height: 1.45; color: var(--slate); }

  /* Workflows: one row each; open a row to switch between before and now. */
  .flows { padding-top: 0; }
  .sec-h { margin-bottom: var(--s4); max-width: 820px; }
  .wfl { border-top: 1.5px solid var(--line); }
  .wf { border-bottom: 1.5px solid var(--line); }
  .wf > summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(0, 1fr) auto 28px; gap: var(--s3); align-items: center; padding: var(--s3) 0; }
  .wf > summary::-webkit-details-marker { display: none; }
  .wf > summary:hover .wf-name { color: var(--sunrise-text); }
  .wf-head { display: grid; gap: 6px; }
  .wf-name { font-size: clamp(24px, 2.2vw, 32px); line-height: 1.1; transition: color .15s; }
  .wf-line { font-size: 16px; color: var(--slate); }
  /* Open rows show the one-liner in the body instead, so it is never said twice. */
  .wf[open] .wf-line { display: none; }
  .wf-pct { font-size: 14px; color: var(--slate); white-space: nowrap; text-align: right; }
  .wf-pct .d { font-size: clamp(24px, 2.2vw, 30px); color: var(--ink); margin-right: 4px; }
  .wf-chev { width: 12px; height: 12px; border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); transform: rotate(45deg) translate(-3px, -3px); justify-self: center; transition: transform .2s; }
  .wf[open] .wf-chev { transform: rotate(225deg) translate(-3px, -3px); }
  .wf-body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(260px, 4fr); gap: clamp(32px, 5vw, 72px); padding: var(--s1) 0 var(--s5); align-items: start; }
  .wf-copy { display: grid; gap: var(--s3); align-content: start; }
  .seg { display: inline-flex; justify-self: start; padding: 4px; border-radius: 99px; background: var(--morning); }
  .seg button { font: 600 14px var(--body); border: 0; background: none; color: var(--slate); padding: 8px 18px; border-radius: 99px; cursor: pointer; }
  .seg button[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .wf-state { display: grid; gap: var(--s2); }
  .wf-sum { font-size: clamp(22px, 1.9vw, 27px); line-height: 1.2; text-wrap: balance; }
  .wf-detail { font-size: 17px; line-height: 1.7; max-width: 62ch; }
  .wf-people { background: var(--first-light); border-radius: 12px; padding: var(--s2) var(--s3); font-size: 16px; line-height: 1.55; margin-top: var(--s1); max-width: 62ch; }
  .wf-team { justify-self: start; font-size: 15px; }
  /* Time card: the same in both states; the switch only changes which row is highlighted. */
  .wf-time { background: var(--morning); border-radius: 20px; padding: var(--s4) var(--s3); display: grid; gap: var(--s3); }
  .wt-row { display: grid; grid-template-columns: 1fr auto; gap: 8px var(--s2); align-items: baseline; }
  .wt-lab { font-size: 14px; font-weight: 600; color: var(--slate); }
  .wt-val { font-size: clamp(24px, 2vw, 30px); line-height: 1; }
  .wt-row .bar-track { grid-column: 1 / -1; }
  .bar-track { height: 10px; border-radius: 99px; background: #fff; overflow: hidden; display: block; }
  .bar { display: block; height: 100%; border-radius: 99px; min-width: 6px; transition: opacity .2s, background .2s; }
  .bar-before { background: var(--slate); opacity: .45; }
  .bar-after { background: var(--sunrise); }
  .wt-pct { border-top: 1px solid var(--line); padding-top: var(--s2); font-size: 14px; color: var(--slate); }
  .wt-pct .d { font-size: 24px; color: var(--ink); margin-right: 4px; }
  /* Before/Now state, set by the script. Without it, every line shows. */
  [data-state='now'] [data-when='before'], [data-state='before'] [data-when='now'] { display: none; }
  .wf[data-state='before'] .bar-before { opacity: 1; background: var(--ink); }
  .wf[data-state='before'] .bar-after { opacity: .45; }
  .wf[data-state='before'] [data-bar='now'] .wt-val, .wf[data-state='now'] [data-bar='before'] .wt-val { color: var(--slate); }

  /* Team: an org chart. Staff on top; their AI agents report in beneath, joined by a line. */
  .team-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s3); flex-wrap: wrap; margin-bottom: var(--s4); }
  .seg-white { background: #fff; }
  .org { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .org-col { display: grid; }
  .org-staff { background: var(--ink); color: #fff; border-radius: 20px; padding: var(--s3); display: grid; gap: 8px; font-size: 15px; line-height: 1.5; position: relative; transition: background .2s, color .2s; }
  .org-role { font-weight: 600; font-size: 18px; color: var(--sunrise); }
  [data-state='before'] .org-staff { background: #fff; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line); }
  [data-state='before'] .org-role { color: var(--ink); }
  .org-ai { list-style: none; margin: 0; padding: var(--s2) 0 0 var(--s4); display: grid; gap: 12px; position: relative; }
  /* The reporting line: down from the staff card, then across to each agent. */
  .org-ai::before { content: ''; position: absolute; left: 22px; top: 0; bottom: 34px; width: 2px; background: var(--line); }
  .org-ai li { position: relative; background: #fff; border-radius: 16px; padding: 14px var(--s3); display: grid; gap: 4px; font-size: 14px; line-height: 1.5; }
  .org-ai li::before { content: ''; position: absolute; left: calc(-1 * var(--s4) + 22px); top: 30px; width: calc(var(--s4) - 22px); height: 2px; background: var(--line); }
  .org-ai-name { font-weight: 600; font-size: 15px; }

  /* Story: contents on the left, reading column on the right. */
  .story { display: grid; grid-template-columns: minmax(200px, 3fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .toc { position: sticky; top: var(--s4); }
  .toc-h { font-weight: 600; margin-bottom: var(--s2); }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; border-left: 2px solid var(--line); }
  .toc a { display: block; padding: 6px 0 6px var(--s2); margin-left: -2px; border-left: 2px solid transparent; color: var(--slate); text-decoration: none; font-size: 15px; line-height: 1.4; }
  .toc a:hover { color: var(--ink); border-left-color: var(--sunrise); }
  .story-text { max-width: 700px; }
  .story-text :global(h2:first-child) { margin-top: 0; }
  .story-text :global(h2) { scroll-margin-top: var(--s4); }

  @media (max-width: 960px) {
    .results { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wf-body { grid-template-columns: 1fr; }
    .hero { grid-template-columns: 1fr; align-items: start; }
    .team { grid-template-columns: 1fr; }
    .story { grid-template-columns: 1fr; }
    .toc { position: static; }
  }
  @media (max-width: 640px) {
      .wf > summary { grid-template-columns: minmax(0, 1fr) 20px; }
    .wf-pct { grid-column: 1; grid-row: 2; text-align: left; }
    .team-staff, .team-ai { grid-template-columns: 1fr; }
  }
</style>
