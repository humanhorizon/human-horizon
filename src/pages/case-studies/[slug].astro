---
// One case study: results, the workflows before and after, then the story told as Implement, Train, Adopt.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import CloseCta from '../../components/CloseCta.astro';
import { site, industries, teams } from '../../data/site';
import { close } from '../../data/home';
import { fmtDate } from '../../lib/insights';
import { getCaseStudies, type CaseStudy } from '../../lib/caseStudies';
import '../../styles/prose.css';

export async function getStaticPaths() {
  return (await getCaseStudies()).map((cs) => ({ params: { slug: cs.id }, props: { cs } }));
}

const { cs } = Astro.props as { cs: CaseStudy };
const { Content } = await render(cs);
const d = cs.data;
const url = `${site.url}/case-studies/${cs.id}`;
const industry = industries.find((s) => s.slug === d.industry);
const teamOf = (slug: string) => teams.find((t) => t.slug === slug);
const lower = (s: string) => s[0].toLowerCase() + s.slice(1);
const iso = (x: Date) => `${x.toISOString().slice(0, 10)}T00:00:00+08:00`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${d.client}: ${d.title}`,
    description: d.description,
    datePublished: iso(d.date),
    dateModified: iso(d.updated ?? d.date),
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: { '@type': 'Organization', name: site.name, url: site.url, logo: { '@type': 'ImageObject', url: `${site.url}/logo/human-horizon-horizontal-full-colour.svg` } },
    about: { '@type': 'Organization', name: d.client, ...(d.website && { url: d.website }), description: d.about },
    mainEntityOfPage: url,
    image: `${site.url}/og.png`,
    articleSection: 'Case studies',
    inLanguage: 'en-SG',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Case studies', item: `${site.url}/case-studies` },
      { '@type': 'ListItem', position: 3, name: d.client, item: url },
    ],
  },
];
---
<Base title={d.seoTitle} description={d.description} schema={schema} ogType="article">
  {!d.publish && <p class="draft-bar">Draft: shown on the dev server only. It goes live once the client approves and YJ ticks Approve to publish.</p>}
  <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/case-studies">Case studies</a> / <span aria-current="page">{d.client}</span></nav>

  <PageHero kicker={`Case study: ${d.client}`} title={d.title} lead={d.summary} secondary={{ label: 'See the workflows', href: '#workflows' }} />

  <section class="section results-sec">
    <div class="wrap">
      <ul class="results" aria-label="Results">
        {d.results.map((r) => <li><p class="d r-val">{r.value}</p><p class="r-lab">{r.label}</p></li>)}
      </ul>
      <dl class="facts">
        <div><dt>Client</dt><dd>{d.website ? <a href={d.website} rel="noopener">{d.client}</a> : d.client}. {d.about}</dd></div>
        <div><dt>Engagement</dt><dd>{d.engagement}</dd></div>
        {d.tools.length > 0 && <div><dt>AI tools</dt><dd>{d.tools.join(', ')}</dd></div>}
        {industry && <div><dt>Industry</dt><dd><a href={`/industries/${industry.slug}`}>{industry.name}</a></dd></div>}
        {d.teams.length > 0 && <div><dt>Teams</dt><dd>{d.teams.map(teamOf).filter(Boolean).map((t, i) => <>{i > 0 && ', '}<a href={`/teams/${t!.slug}`}>{t!.name}</a></>)}</dd></div>}
      </dl>
    </div>
  </section>

  <section class="section" id="workflows">
    <div class="wrap">
      <h2 class="d h2 sec-h">What changed, workflow by workflow</h2>
      <div class="wfs">
        {d.workflows.map((w) => {
          const t = teamOf(w.team);
          return (
            <div class="wf">
              <h3 class="h3">{w.name}</h3>
              <BeforeAfter workflow={{ name: w.name, outcome: w.outcome, before: w.before, after: w.after }} />
              <p class="wf-people"><strong>Where people spend their time now:</strong> {w.people}</p>
              {t && <a class="lnk" href={`/teams/${t.slug}`}>More on AI for {lower(t.name)}</a>}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <div class="wrap"><article class="prose cs-prose"><Content /></article></div>
  <p class="wrap cap cs-date">Published {fmtDate(d.date)}{d.updated && `, updated ${fmtDate(d.updated)}`}. Shared with the approval of {d.client}.</p>

  <CloseCta title={close.title} sub={close.sub} />
</Base>

<style>
  .draft-bar { background: var(--first-light); text-align: center; padding: 10px var(--gutter); font-size: 14px; font-weight: 600; }
  .crumbs { padding-top: var(--s3); font-size: 14px; color: var(--slate); }
  .crumbs a { color: var(--slate); }
  .results-sec { padding-top: 0; }
  .results { list-style: none; margin: 0; padding: clamp(24px, 4vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--s4); background: var(--ink); color: #fff; border-radius: 20px; }
  .r-val { font-size: clamp(40px, 4vw, 56px); line-height: 1; color: var(--sunrise); }
  .r-lab { margin-top: 12px; color: var(--on-ink); font-size: 16px; line-height: 1.5; }
  .facts { margin: var(--s4) 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--s3); }
  .facts > div:first-child { grid-column: 1 / -1; }
  .facts dt { font-weight: 600; font-size: 14px; color: var(--slate); margin-bottom: 4px; }
  .facts dd { margin: 0; font-size: 16px; line-height: 1.55; }
  .sec-h { margin-bottom: var(--s4); max-width: 820px; }
  .wfs { display: grid; gap: var(--s5); }
  .wf { display: grid; gap: var(--s2); }
  .wf-people { font-size: 16px; }
  .cs-prose { max-width: 720px; padding-bottom: var(--s4); }
  .cs-date { padding-bottom: var(--section); }
</style>
