---
// The AI glossary: every published term A to Z with its short definition, a letter bar and a
// search box that filters in the page. Out of search until the first term is published.
import Base from '../../../layouts/Base.astro';
import CloseCta from '../../../components/CloseCta.astro';
import { close } from '../../../data/home';
import { site } from '../../../data/site';
import { insights } from '../../../data/companyPages';
import { getTerms, termCard, letterOf } from '../../../lib/insights';

const terms = (await getTerms()).map(termCard);
const groups = [...new Set(terms.map((t) => letterOf(t.title)))].map((l) => ({ l, id: l === '#' ? 'num' : l.toLowerCase(), items: terms.filter((t) => letterOf(t.title) === l) }));
const url = `${site.url}/insights/glossary`;

const schema = [
  { '@context': 'https://schema.org', '@type': 'DefinedTermSet', '@id': `${url}#set`, name: 'Human Horizon AI glossary', description: insights.glossaryLead, url,
    hasDefinedTerm: terms.map((t) => ({ '@type': 'DefinedTerm', name: t.title, description: t.description, url: `${site.url}${t.href}` })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: `${site.url}/insights` },
    { '@type': 'ListItem', position: 3, name: 'Glossary' },
  ] },
];
---
<Base title="AI glossary: AI terms in plain English | Human Horizon" description="An AI glossary for Singapore teams: plain-English definitions of the AI terms that come up at work, each with an example and what it means for your team." schema={schema} noindex={terms.length === 0}>
  <nav class="wrap crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/insights">Insights</a> / <span aria-current="page">Glossary</span></nav>
  <header class="wrap gh">
    <h1 class="d gh-h">{insights.glossaryTitle}</h1>
    <div class="gh-side">
      <p class="lead muted">{insights.glossaryLead}</p>
      {terms.length > 0 && (
        <label class="search" data-search hidden>
          <span class="sr-only">Search the glossary</span>
          <input type="search" placeholder="Search terms" autocomplete="off" />
        </label>
      )}
    </div>
  </header>

  {terms.length > 0 ? (
    <>
      <nav class="az-bar" aria-label="Jump to letter">
        <div class="wrap az">{groups.map((g) => <a href={`#${g.id}`}>{g.l}</a>)}</div>
      </nav>
      <div class="wrap gl">
        {groups.map((g) => (
          <section class="grp" id={g.id} aria-labelledby={`h-${g.id}`} data-group>
            <h2 id={`h-${g.id}`} class="d grp-l">{g.l}</h2>
            <ul class="grp-list">
              {g.items.map((t) => (
                <li data-term={`${t.title} ${t.description}`.toLowerCase()}>
                  <a href={t.href}>
                    <span class="d term">{t.title}</span>
                    <span class="muted def">{t.description}</span>
                    <span class="cap">{t.category}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
        <p class="muted none" data-none hidden>No term matches that search yet. Ask us on a call and we may add it.</p>
      </div>
    </>
  ) : (
    <section class="section"><div class="wrap"><p class="lead muted">The first terms are on their way.</p></div></section>
  )}

  <CloseCta title={close.title} sub={close.sub} />
</Base>

<script>
  // In-page search. Without JavaScript the full list shows and the search box stays hidden.
  const box = document.querySelector<HTMLElement>('[data-search]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  if (box && none) {
    box.hidden = false;
    box.querySelector('input')!.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      let any = false;
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        let shown = 0;
        g.querySelectorAll<HTMLElement>('[data-term]').forEach((li) => {
          const ok = !q || li.dataset.term!.includes(q);
          li.hidden = !ok;
          if (ok) shown++;
        });
        g.hidden = shown === 0;
        if (shown) any = true;
      });
      none.hidden = any;
    });
  }
</script>

<style>
  .crumbs { padding-top: var(--s3); font-size: 14px; color: var(--slate); }
  .crumbs a { color: var(--slate); }
  .gh { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s5); align-items: end; padding-top: clamp(40px, 6vw, 88px); padding-bottom: var(--s5); }
  .gh-h { font-size: clamp(45px, 6.3vw, 90px); line-height: .92; letter-spacing: -0.03em; }
  .gh-side { display: grid; gap: var(--s3); }
  .search input { width: 100%; min-height: 52px; padding: 0 20px; border-radius: 999px; border: 1.5px solid var(--ink); font: 400 17px var(--text); color: var(--ink); background: var(--white); }
  .az-bar { position: sticky; top: 0; z-index: 5; background: var(--ink); }
  .az { display: flex; flex-wrap: wrap; gap: 4px; padding-top: 10px; padding-bottom: 10px; }
  .az a { display: grid; place-items: center; min-width: 38px; height: 38px; border-radius: 10px; color: var(--white); text-decoration: none; font-weight: 600; font-size: 15px; }
  .az a:hover { background: var(--sunrise); color: var(--ink); }
  .gl { padding-top: var(--s4); padding-bottom: var(--section); }
  .grp { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: var(--s3); padding: var(--s4) 0; border-top: 2px solid var(--ink); scroll-margin-top: 72px; }
  .grp-l { font-size: clamp(45px, 4.2vw, 62px); line-height: .9; color: var(--sunrise-text); }
  .grp-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2) var(--s4); }
  .grp-list a { display: grid; gap: 6px; padding: var(--s2); margin: calc(var(--s2) * -1); border-radius: 16px; text-decoration: none; color: inherit; }
  .grp-list a:hover { background: var(--morning); }
  .term { font-size: 28px; line-height: 1.1; }
  .def { font-size: 16px; line-height: 1.55; }
  .none { padding: var(--s4) 0; }
  @media (max-width: 860px) { .gh { grid-template-columns: 1fr; gap: var(--s3); } .grp-list { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .grp { grid-template-columns: 1fr; gap: var(--s2); } }
</style>
